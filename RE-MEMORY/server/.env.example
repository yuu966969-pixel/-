# Free local AI (default): install Ollama and download qwen3:4b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
PORT=3000

# Optional cloud mode. This may incur API charges; leave AI_PROVIDER=ollama for local free mode.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Optional: exact public game origin if cross-origin access is needed.
ALLOWED_ORIGIN=
